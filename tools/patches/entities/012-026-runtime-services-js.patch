+    // --- [LuzzyRP patch 015] Anthropic Messages 协议适配 ---
+    // 图片消息转为 base64 source；system 从 messages 抽出；max_tokens 必填。
+    const toAnthropicMessages = (messages) => {
+        let system = '';
