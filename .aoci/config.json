{
  "version": 2,
  "locale": "zh-CN",
  "index_path": "aoci.txt",
  "exclude_dirs": [
    "node_modules",
    "vendor",
    "dist",
    "build",
    "target",
    ".next",
    "coverage",
    "tmp",
    "uploads",
    "backup",
    "backups",
    "artifacts",
    ".output",
    "__pycache__",
    ".venv",
    "venv",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    ".tox",
    ".nox",
    "htmlcov"
  ],
  "exclude_files": [
    "*.backup.*",
    "*.bak",
    ".coverage"
  ],
  "exclude_exts": [],
  "curation_exclude": [],
  "hook_strict": false,
  "ledger_enabled": true,
  "line_ending_tolerance": true,
  "cognition_refresh_threshold": 30,
  "overview_delivery": {
    "chunk_tokens": 8000
  },
  "managed_scope": {
    "version": "managed-scope-policy/v2",
    "profile": "production",
    "observe_change_policy": "review_required",
    "approval_mode": "inherit",
    "approval_thresholds": {
      "entry_removal_count": 25,
      "entry_removal_percent": 25
    },
    "rules": [
      {
        "rule_id": "luzzyp-frozen-skill-archives",
        "action": "exclude",
        "pattern": "docs/skills",
        "pattern_kind": "directory",
        "reason": "第三方技能仓库的整仓存档副本，14191 文件 / 约 497 万行；属于外部项目的代码，不是 LuzzyRP 的语义。存档用于阅读，不作为本仓库的受管认知对象",
        "decision_basis": "duplicate_semantics",
        "source": "user",
        "created_by": "LuzzyMeow",
        "order": 10,
        "enabled": true
      },
      {
        "rule_id": "luzzyp-binary-images",
        "action": "exclude",
        "pattern": "**/*.png",
        "pattern_kind": "glob",
        "reason": "图片素材：图标与位图，认知由引用它们的代码条目承载，逐张写条目会稀释索引信号",
        "decision_basis": "generated_asset",
        "source": "user",
        "created_by": "LuzzyMeow",
        "order": 20,
        "enabled": true
      },
      {
        "rule_id": "luzzyp-binary-webp",
        "action": "exclude",
        "pattern": "**/*.webp",
        "pattern_kind": "glob",
        "reason": "图片素材，同 png 规则",
        "decision_basis": "generated_asset",
        "source": "user",
        "created_by": "LuzzyMeow",
        "order": 30,
        "enabled": true
      },
      {
        "rule_id": "luzzyp-binary-jpg",
        "action": "exclude",
        "pattern": "**/*.jpg",
        "pattern_kind": "glob",
        "reason": "图片素材，同 png 规则",
        "decision_basis": "generated_asset",
        "source": "user",
        "created_by": "LuzzyMeow",
        "order": 40,
        "enabled": true
      },
      {
        "rule_id": "luzzyp-binary-jpeg",
        "action": "exclude",
        "pattern": "**/*.jpeg",
        "pattern_kind": "glob",
        "reason": "图片素材，同 png 规则",
        "decision_basis": "generated_asset",
        "source": "user",
        "created_by": "LuzzyMeow",
        "order": 50,
        "enabled": true
      },
      {
        "rule_id": "luzzyp-binary-gif",
        "action": "exclude",
        "pattern": "**/*.gif",
        "pattern_kind": "glob",
        "reason": "图片素材，同 png 规则",
        "decision_basis": "generated_asset",
        "source": "user",
        "created_by": "LuzzyMeow",
        "order": 60,
        "enabled": true
      },
      {
        "rule_id": "luzzyp-binary-svg",
        "action": "exclude",
        "pattern": "**/*.svg",
        "pattern_kind": "glob",
        "reason": "矢量图素材，认知由使用它的代码承载",
        "decision_basis": "generated_asset",
        "source": "user",
        "created_by": "LuzzyMeow",
        "order": 70,
        "enabled": true
      },
      {
        "rule_id": "luzzyp-binary-fonts-ttf",
        "action": "exclude",
        "pattern": "**/*.ttf",
        "pattern_kind": "glob",
        "reason": "字体二进制，字族语义由 theme 层代码条目承载",
        "decision_basis": "generated_asset",
        "source": "user",
        "created_by": "LuzzyMeow",
        "order": 80,
        "enabled": true
      },
      {
        "rule_id": "luzzyp-binary-fonts-otf",
        "action": "exclude",
        "pattern": "**/*.otf",
        "pattern_kind": "glob",
        "reason": "字体二进制，同 ttf 规则",
        "decision_basis": "generated_asset",
        "source": "user",
        "created_by": "LuzzyMeow",
        "order": 90,
        "enabled": true
      },
      {
        "rule_id": "luzzyp-binary-fonts-woff",
        "action": "exclude",
        "pattern": "**/*.woff",
        "pattern_kind": "glob",
        "reason": "字体二进制，同 ttf 规则",
        "decision_basis": "generated_asset",
        "source": "user",
        "created_by": "LuzzyMeow",
        "order": 100,
        "enabled": true
      },
      {
        "rule_id": "luzzyp-binary-fonts-woff2",
        "action": "exclude",
        "pattern": "**/*.woff2",
        "pattern_kind": "glob",
        "reason": "字体二进制，同 ttf 规则",
        "decision_basis": "generated_asset",
        "source": "user",
        "created_by": "LuzzyMeow",
        "order": 110,
        "enabled": true
      },
      {
        "rule_id": "luzzyp-binary-audio-mp3",
        "action": "exclude",
        "pattern": "**/*.mp3",
        "pattern_kind": "glob",
        "reason": "音频素材，不含可读语义",
        "decision_basis": "generated_asset",
        "source": "user",
        "created_by": "LuzzyMeow",
        "order": 120,
        "enabled": true
      },
      {
        "rule_id": "luzzyp-binary-audio-wav",
        "action": "exclude",
        "pattern": "**/*.wav",
        "pattern_kind": "glob",
        "reason": "音频素材，不含可读语义",
        "decision_basis": "generated_asset",
        "source": "user",
        "created_by": "LuzzyMeow",
        "order": 130,
        "enabled": true
      },
      {
        "rule_id": "luzzyp-binary-video-mp4",
        "action": "exclude",
        "pattern": "**/*.mp4",
        "pattern_kind": "glob",
        "reason": "视频素材，不含可读语义",
        "decision_basis": "generated_asset",
        "source": "user",
        "created_by": "LuzzyMeow",
        "order": 140,
        "enabled": true
      },
      {
        "rule_id": "luzzyp-binary-archives-jar",
        "action": "exclude",
        "pattern": "**/*.jar",
        "pattern_kind": "glob",
        "reason": "二进制归档：gradle wrapper 引导 jar，为二进制且无 FRAS 语义。它由 Git 跟踪且是 ./gradlew 的必需组件，不属于业务源码、但不可删除",
        "decision_basis": "generated_asset",
        "source": "user",
        "created_by": "LuzzyMeow",
        "order": 150,
        "enabled": true
      }
    ]
  },
  "cognition_budget": {
    "version": "cognition-budget-policy/v1",
    "mode": "enforce",
    "whole_index": {
      "target_tokens": 200000,
      "warning_tokens": 300000,
      "max_tokens": 400000
    },
    "r": [
      {
        "min_c": 1,
        "max_c": 4,
        "target_tokens": 25,
        "max_tokens": 50
      },
      {
        "min_c": 5,
        "max_c": 7,
        "target_tokens": 45,
        "max_tokens": 90
      },
      {
        "min_c": 8,
        "max_c": 8,
        "target_tokens": 70,
        "max_tokens": 140
      },
      {
        "min_c": 9,
        "max_c": 9,
        "target_tokens": 90,
        "max_tokens": 180
      }
    ],
    "s": [
      {
        "min_c": 1,
        "max_c": 4,
        "target_tokens": 20,
        "max_tokens": 40
      },
      {
        "min_c": 5,
        "max_c": 7,
        "target_tokens": 40,
        "max_tokens": 80
      },
      {
        "min_c": 8,
        "max_c": 8,
        "target_tokens": 70,
        "max_tokens": 140
      },
      {
        "min_c": 9,
        "max_c": 9,
        "target_tokens": 100,
        "max_tokens": 200
      }
    ]
  },
  "installed_agents": [],
  "automation": {
    "mode": "auto"
  },
  "ai": {
    "enabled": false,
    "provider": "openai-compatible",
    "base_url": "",
    "model": "",
    "api_key_env": "",
    "timeout_seconds": 0,
    "max_concurrency": 0,
    "max_input_tokens": 0,
    "token_accounting": "auto",
    "prompt_snapshot": "redacted"
  }
}
