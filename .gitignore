# ===== LuzzyRP .gitignore =====

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/**/build/
local.properties

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
.DS_Store
captures/
.externalNativeBuild/
.cxx/

# Keystore（签名密钥严禁入库）
*.jks
*.keystore
!debug.keystore
keystore.properties
docs/RELEASE-KEY.md

# 本地参考归档（旧仓库源码备份，不入库）
docs/archive/

# 上游参考克隆（独立 git 仓库，tools/sync-upstream.ps1 依赖其 fetch upstream；
# 不随仓库分发——克隆者自行 clone 上游或直接用 assets/rphub 手动同步）
rp-hub-reference/

# 运行日志与临时文件
*.log
logs/
.DS_Store
Thumbs.db

# Kotlin/Java
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar

# Room schema 导出目录中的临时文件（schemas 本身需要入库）
*.bak

# 方向板本地字体（与 app/src/main/assets/rphub/assets/fonts 重复，PNG 为持久产物）
docs/design/boards-v2/fonts/

# ZCode 会话本地数据（计划/缓存等，仅本机）
.zcode/
