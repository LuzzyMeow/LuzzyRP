<?xml version="1.0" encoding="utf-8"?>
<!-- LuzzyRP 主清单（v1.0.0 WebView 壳） -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络访问：用户配置的 LLM API 端点请求（RP-Hub 运行时需要） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 导出下载（DownloadManager 写入外部下载目录；API 29+ 走 SAF 无需此权限） -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- 助手「日历读写」工具（calendar_read / calendar_write）：运行时权限，**未声明则永远无法授予**。
         2026-09-11 静态审查修复——此前只在代码里检查权限却没在清单声明，且 App 内也没有申请流程，
         该工具必然失败。授权入口：助手设置页 → 工具开关 → 日历权限 → 授予。 -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LuzzyRP"
        tools:targetApi="37">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- [v3.0 P1] Compose 界面宿主（空壳验证用）：launcher 仍为 MainActivity（WebView），
             本 Activity 仅经 adb am start 显式启动做 P1-P5 开发验证；P6 切换时才接任 launcher。 -->
        <activity
            android:name=".ui.ComposeActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale" />
    </application>

</manifest>
