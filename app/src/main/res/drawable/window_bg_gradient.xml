<?xml version="1.0" encoding="utf-8"?>
<!--
    窗口背景渐变：与 RP-Hub 页面顶栏无缝衔接。

    问题：Android 15+ 强制 edge-to-edge，WebView 内容被系统栏 insets 推下后，
    顶部露出的状态栏区域显示纯白 windowBackground，与页面顶栏深灰渐变形成断崖。

    方案：angle=270 表示从上到下渐变。0% (#8B8886，比顶栏起始略浅) →
    5% (#7D7A77，顶栏起始灰) → 8% (#FAF9F5 纯白)。WebView 内容区从状态栏
    下方开始覆盖，可见区只有顶部状态栏条 + 底部导航条：
      - 顶部状态栏条 → 显示 #8A8A8A→#7C7D7D，与顶栏渐变自然衔接；
      - 底部导航条 → 渐变已完成到白色，与页面浅色背景连续。

    注意：stop 百分比按典型设备估算（状态栏 24-30dp / 屏幕高 800dp+）；
    若新设备出现轻微色差，微调 5%/8% 两个值即可（数值见注释）。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="270"
        android:startColor="#8A8A8A"
        android:centerColor="#7C7D7D"
        android:endColor="#FFFFFF"
        android:centerY="0.05"
        android:type="linear" />
</shape>
